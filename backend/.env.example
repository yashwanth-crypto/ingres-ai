# Local PostgreSQL for development; Railway injects its own DATABASE_URL when
# deployed. Percent-encode the password if it contains @ : or / (@ -> %40).
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/ingres

# LLM backend for the agent pipeline.
#   ollama    - free, local, works offline (needs `ollama serve` running)
#   anthropic - Claude API, best verification quality, ~$0.02 per question
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Comma-separated. Never use "*" - see Section 10 of the spec.
ALLOWED_ORIGINS=http://localhost:5173
